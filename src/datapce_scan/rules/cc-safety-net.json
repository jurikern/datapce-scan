{
 "name": "cc-safety-net",
 "version": 1,
 "description": "Own paraphrase of the CC Safety Net destructive-command rules for rm and git (default policy). Written from the rule logic in src/gate/analyzer/rm.ts and src/gate/analyzer/git/rules.ts; no code copied. Not modelled: secret-file rules, pipe-to-shell, temp-repo and worktree relaxations, rulebook packs, checkout path heuristics.",
 "source_url": "https://github.com/kenryu42/cc-safety-net",
 "files": ["src/gate/analyzer/rm.ts", "src/gate/analyzer/git/rules.ts"],
 "upstream_commit": "6dc120f4b9475dbc8bbb23faf9011aab5f4ed59e",
 "licence": "MIT",
 "licence_url": "https://github.com/kenryu42/cc-safety-net/blob/main/LICENSE",
 "reuse": "own paraphrase of rule logic (rule ids kept), with attribution",
 "fetched": "2026-10-22",
 "attribution": "CC Safety Net, kenryu42",
 "rules": [
  {"name": "rm.recursive-force-root-or-home", "action": "deny",
   "match": {"kind": "rm", "flags": ["recursive"], "target": ["root", "home"]}},
  {"name": "rm.recursive-force-dynamic-target", "action": "deny",
   "match": {"kind": "rm", "flags": ["recursive"], "target": ["dynamic"]}},
  {"name": "rm.recursive-force-home-cwd", "action": "deny",
   "match": {"kind": "rm", "flags": ["recursive"], "target": ["cwd_is_home"]}},
  {"name": "rm.recursive-force-cwd-self", "action": "deny",
   "match": {"kind": "rm", "flags": ["recursive"], "target": ["cwd_self"]}},
  {"name": "rm.recursive-force-outside-cwd", "action": "deny",
   "match": {"kind": "rm", "flags": ["recursive"], "target": ["outside_cwd"]}},
  {"name": "git.checkout-force", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["checkout"], "any": [{"long": "--force"}, {"short": "f"}]}},
  {"name": "git.checkout-pathspec-from-file", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["checkout"], "any": [{"long": "--pathspec-from-file"}]}},
  {"name": "git.checkout-double-dash", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["checkout"], "all": [{"after_dd": true}],
             "none": [{"short": "b"}, {"short": "B"}, {"long": "--orphan"}]}},
  {"name": "git.checkout-path", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["checkout"], "any": [{"word": "."}, {"word": ".."}]}},
  {"name": "git.switch-discard-changes", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["switch"], "any": [{"long": "--discard-changes"}]}},
  {"name": "git.switch-force", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["switch"], "any": [{"long": "--force"}, {"short": "f"}]}},
  {"name": "git.restore-worktree", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["restore"], "any": [{"long": "--worktree"}, {"short": "W"}],
             "none": [{"long": "--help"}, {"short": "h"}, {"long": "--patch"}, {"short": "p"}]}},
  {"name": "git.restore-unstaged", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["restore"],
             "all": [{"not": {"long": "--staged"}}, {"not": {"short": "S"}}],
             "none": [{"long": "--help"}, {"short": "h"}, {"long": "--patch"}, {"short": "p"}]}},
  {"name": "git.reset-hard", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["reset"], "any": [{"long": "--hard"}]}},
  {"name": "git.reset-merge", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["reset"], "any": [{"long": "--merge"}]}},
  {"name": "git.clean-force", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["clean"], "any": [{"long": "--force"}, {"short": "f"}],
             "none": [{"short": "n"}, {"long": "--dry-run"}]}},
  {"name": "git.rm-force", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["rm"], "any": [{"long": "--force"}, {"short": "f"}],
             "none": [{"long": "--cached"}, {"long": "--dry-run"}, {"short": "n"}]}},
  {"name": "git.push-mirror", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["push"], "any": [{"long": "--mirror"}]}},
  {"name": "git.push-force", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["push"],
             "any": [{"long": "--force"}, {"short": "f"}, {"pos_prefix": "+"}, {"pos_contains": ":+"}]}},
  {"name": "git.push-delete", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["push"],
             "any": [{"long": "--delete"}, {"short": "d"}, {"pos_prefix": ":"}]}},
  {"name": "git.branch-force-delete", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["branch"],
             "any": [{"short": "D"},
                     {"all": [{"any": [{"short": "d"}, {"long": "--delete"}]},
                              {"any": [{"short": "f"}, {"long": "--force"}]}]}]}},
  {"name": "git.rebase-abort", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["rebase"], "any": [{"long": "--abort"}]}},
  {"name": "git.merge-abort", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["merge"], "any": [{"long": "--abort"}]}},
  {"name": "git.tag-delete", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["tag"], "any": [{"short": "d"}, {"long": "--delete"}]}},
  {"name": "git.reflog-delete", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["reflog"], "all": [{"first": "delete"}]}},
  {"name": "git.stash-drop", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["stash"], "any": [{"word": "drop"}]}},
  {"name": "git.stash-clear", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["stash"], "any": [{"word": "clear"}]}},
  {"name": "git.worktree-remove-force", "action": "deny",
   "match": {"kind": "argv", "cmd": ["git"], "sub": ["worktree"], "all": [{"word": "remove"}],
             "any": [{"long": "--force"}, {"short": "f"}]}}
 ]
}
